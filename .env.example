NODE_ENV=development
PORT=3001
APP_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/docchase
JWT_SECRET=replace-with-at-least-32-random-characters
RUN_WORKER=true
DEMO_MODE=false
STORAGE_PROVIDER=local
UPLOAD_DIR=.local/uploads
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-in-host-settings-only
SUPABASE_BUCKET=docchase-private
EXTRACTOR_PROVIDER=manual
GEMINI_API_KEY=replace-in-host-settings-only
GEMINI_MODEL=gemini-3.5-flash-lite
DAILY_EXTRACTION_LIMIT=40
MAIL_PROVIDER=console
BREVO_API_KEY=replace-in-host-settings-only
MAIL_FROM=verified-sender@example.com
SCHEDULER_SECRET=replace-with-at-least-32-random-characters
